---
import { GetListArticle } from "../../../app/feature/article";
import {createApi} from "../../../lib/api/api-client"
import type { UserSession } from "../../../app/feature/auth/types";
import { createAuthApi } from "../../../app/feature/auth/index";
import { createProfileApi } from "../../../app/feature/profile/index";
import type {
    ArticleListResponse,
} from "../../../contract/article";
import { ArticleManagementLayout } from "../../../layouts/dashboard/ArticleManagement";
import Layout from "../../../layouts/Layout.astro";
import { ApiError } from "../../../lib/api/error";
import CategoryManager, { ArticleManage } from "./_manage";
import type { ProfileResponse } from "../../../contract/profile";
import { profile } from "node:console";
import { createCategoryApi } from "../../../app/feature/category";
import type { categoryResponse } from "../../../app/feature/category/type";

let Article: ArticleListResponse | null = null;
let Profile: ProfileResponse | null = null;
let category: categoryResponse[] | null = null;
let isLogin :boolean = false
let debug : UserSession | null = null 

const cookie = Astro.request.headers.get("cookie") || "";
console.log(cookie)
try {
    const api = createApi({cookie:cookie})
    const sessionRes = await createAuthApi(api).session();
    if (sessionRes.data.id == "") {
        return Astro.redirect("/articles");
    }
    isLogin = true
    const[ArticleRes,ProfileRes,CategoryRes] = await Promise.all( [GetListArticle({ authorId: sessionRes.data.id }), createProfileApi(api).getProfile(),createCategoryApi(api).getCategory()] )

    Article = ArticleRes;
    Profile = ProfileRes.data
    category = CategoryRes.data
} catch (e) {
    if (e instanceof ApiError) {
        if (e.statusCode == 401) {
            console.log("Tidak Login");
            return Astro.redirect("/articles");
        }
        console.log(e)
    }
}
if (!Article || !isLogin || !Profile) return Astro.redirect("/notfound");
---

<Layout>
    <ArticleManagementLayout client:only="react" Profile={Profile}>
        <ArticleManage articles={Article.articles} client:visible />
        <CategoryManager initialCategories={category || []} client:visible/>
    </ArticleManagementLayout>
</Layout>
