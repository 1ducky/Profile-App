---

import { createAuthApi } from "../../../../app/feature/auth";
import { createCategoryApi } from "../../../../app/feature/category";
import Layout from "../../../../layouts/Layout.astro";
import { createApi } from "../../../../lib/api/api-client";
import { ApiError } from "../../../../lib/api/error";
import { CreateArticle } from "./_publish";

const cookie = Astro.request.headers.get("cookie")||"";

let categorySugest : string[] = []
try {
    const api = createApi({cookie:cookie})
    const [sessionRes,categoryRes] = await Promise.all([createAuthApi(api).session(),createCategoryApi(api).getCategory()]);
    if (sessionRes.data.id == "") {
        return Astro.redirect("/articles");
    }
    categorySugest = categoryRes.data.map(i => i.slug)
} catch (e) {
    if (e instanceof ApiError) {
        if (e.statusCode == 401) {
            return Astro.redirect("/articles");
        }
        console.log(e.code)
    }
}
---

<Layout
    title="Editor"
    description="Editor"
    keywords={["editor"]}
    type="website"
    noIndex
>
    <main>
        <CreateArticle autoSuggest={{category:categorySugest}} client:only="react" />
    </main>
</Layout>
