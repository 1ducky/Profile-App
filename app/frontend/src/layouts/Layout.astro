---
import ImageUploaderProvider from "../components/Editor/ImageUploader/ImageProvider";
import Navbar from "../components/frontpage/Navbar";
import "../global.css";
import { AlertProvider } from "../hooks/useAllert";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="font-sans text-surface dark:text-night-surface">
		<Navbar client:load />
		<AlertProvider client:load />
		<ImageUploaderProvider
            client:load
            endpoint="/api/assets/upload"
            fieldName="image"
            maxSizeMB={5}
        />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
